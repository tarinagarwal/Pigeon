# Root compose-level configuration. Copy to .env for `docker compose`.
# Per-service secrets live in each service's own .env (see pigeon-*/.env.example).

# Host ports (left = host, container ports are fixed in docker-compose.yml)
BACKEND_PORT=8001
FRONTEND_PORT=8080
ADMIN_PORT=8082

# MongoDB connection the backend uses. Defaults to the bundled compose Mongo service.
# Override with a managed cluster (e.g. MongoDB Atlas) for production.
MONGO_URL=mongodb://mongo:27017
DB_NAME=pigeon_ai

# Public URLs baked into the Next.js builds at image build time.
NEXT_PUBLIC_API_URL=http://localhost:8001/api
NEXT_PUBLIC_SITE_URL=http://localhost:8080
