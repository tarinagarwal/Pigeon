# Pigeon Admin Panel — environment variables
# Copy to .env.local and fill in. In production (e.g. Vercel) set these in Project → Environment Variables.

# FastAPI backend base URL, including /api (e.g. http://localhost:8001/api)
NEXT_PUBLIC_API_URL=http://localhost:8001/api

# Public marketing site URL (used for links back to the main site)
NEXT_PUBLIC_MAIN_SITE_URL=http://localhost:8080

# Backend/frontend URL used for on-demand revalidation callbacks
FRONTEND_URL=http://localhost:8080

# Shared secret required to trigger Next.js on-demand revalidation. Must match the backend.
REVALIDATE_SECRET=

# Cloudinary — used for uploading blog images from the admin panel.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: Cloudinary folder for blog images (default: blogs)
CLOUDINARY_BLOGS_FOLDER=blogs
