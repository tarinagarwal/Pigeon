# Pigeon marketing site / app frontend (Next.js) — environment variables
# Copy to .env.local and set values. In production (e.g. Vercel) add these in Project → Environment Variables.

# --- API ---
# FastAPI base URL including /api (e.g. http://localhost:8001/api). Server-side proxies normalize this.
NEXT_PUBLIC_API_URL=http://localhost:8001/api
NEXT_PUBLIC_SITE_URL=http://localhost:8080
# Optional: server-side base URL the Next API routes proxy to (defaults to NEXT_PUBLIC_API_URL host).
# BACKEND_PROXY_URL=http://localhost:8001

# --- MongoDB (used by the public contact form /api/contact) ---
MONGO_URL=
# or MONGODB_URI=
DB_NAME=

# --- Slack notifications (contact form) ---
# Create app at https://api.slack.com → OAuth → Bot Token Scopes: chat:write → install → /invite @YourApp in #your-channel
SLACK_BOT_TOKEN=
# Optional: channel ID (C…) or #channel-name (default #pigeon-contact)
# SLACK_CHANNEL_CONTACT=#pigeon-contact

# --- On-demand revalidation ---
# Shared secret to trigger Next.js revalidation from the backend/admin. Must match on both sides.
REVALIDATE_SECRET=

# --- Cloudinary (blog / marketing images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Analytics (optional) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
