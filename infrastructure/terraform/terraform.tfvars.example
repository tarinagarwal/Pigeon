# Copy to terraform.tfvars and fill in. Do not commit terraform.tfvars if it contains secrets.
# Optional: EC2 key pair for SSH. Leave empty "" for SSM-only access (key must exist in this region if set).

aws_region   = "us-east-1"
environment  = "production"
project_name = "pigeon-backend"
key_name     = "" # or "your-ec2-key-pair-name"

# Optional overrides
# instance_type = "t3.small"
# app_port      = 8000
# enable_alb    = true   # ALB free tier: 750 hrs/month + 15 LCUs for 12 months
# ssh_allowed_cidrs = ["1.2.3.4/32"]  # Restrict to your IP or GitHub Actions IPs

# HTTPS on ALB (ACM certificate). Point domain CNAME to ALB; use ACM cert ARN (arn:aws:acm:...).
# enable_https         = true
# acm_certificate_arn  = "arn:aws:acm:us-east-1:ACCOUNT:certificate/CERT-ID"
# domain_name          = "api.pigeon.com"
# If using separate tracking host, include it in the ACM cert too (example: track.pigeon.com).
