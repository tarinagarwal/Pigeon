# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=pigeon_ai

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8001/api/gmail/callback
# Optional: override redirect URI for Gmail warm-up receiver accounts in the admin panel.
# If not set, BACKEND_URL + /api/admin/warmup/gmail-receiver/callback will be used.
# GMAIL_RECEIVER_REDIRECT_URI=http://localhost:8001/api/admin/warmup/gmail-receiver/callback

# Application URLs
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8001
# Optional tracking base host for click/open URLs. If unset, BACKEND_URL is used.
# Lifecycle (signup drip) emails use this for pixel, click, and unsubscribe links — not FRONTEND_URL.
TRACKING_BASE_URL=https://track.pigeon.com
# Expected CNAME target when users verify a custom tracking domain (Phase 2).
TRACKING_CNAME_TARGET=track.pigeon.com
# Optional shared secret used by Caddy ask endpoint (/api/tracking/verify-host).
# TRACKING_PROXY_SHARED_SECRET=change-me
# Admin panel URL (redirect after Outlook OAuth callback). Fallback: FRONTEND_URL
# ADMIN_PANEL_URL=https://admin.example.com

# Microsoft OAuth (Outlook receiver accounts - warm-up). Register app in Azure AD; add redirect URI below.
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_REDIRECT_URI=http://localhost:8001/api/admin/warmup/outlook-receiver/callback

# Dev-only: set EMAIL_DEBUG=1 to see detailed email/batch warnings in server logs (not exposed to users)
# EMAIL_DEBUG=

# Warmup AI/thread controls
WARMUP_GROQ_ENABLED=1
WARMUP_MULTITURN_ENABLED=1
WARMUP_GROQ_MODEL=llama-3.3-70b-versatile
WARMUP_GROQ_TIMEOUT_MS=15000
GROQ_API_KEY=your_groq_api_key_here

# Smart Leads (Serper.dev Google search — server-side only; https://serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_encryption_key_here

# JWT: single secret for both app and admin tokens (admin panel stores token in localStorage).
JWT_SECRET=your-jwt-secret-key-change-in-production
# Dev only: ALLOW_DEV_CREATE_ADMIN=true to enable POST /admin/auth/create-admin.
# ALLOW_DEV_CREATE_ADMIN=
# Script update_admin_password.py only: ADMIN_EMAIL, ADMIN_PASSWORD (login to get JWT; no token in .env).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Auth cookie: set COOKIE_SECURE=true in production (HTTPS) so the auth cookie is sent only over secure connections
# COOKIE_SECURE=false

# CORS Configuration
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# SPF Include Domain (optional, for custom SPF records)
SPF_INCLUDE_DOMAIN=

# AWS – Infrastructure (admin panel)
# On EC2: do NOT set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in .env. The app uses the
# instance IAM role (no creds on disk). Only for local dev or non-EC2 set the vars below.
ASG_NAME=your_asg_name_here
AWS_REGION=us-east-1

# Slack Bot (notifications: contact form -> pigeon-contact, new ticket -> pigeon-ticket)
# Create app at api.slack.com → add Bot User → OAuth & Permissions → Bot Token Scopes: add "chat:write"
# Then install app to workspace and invite the bot to #pigeon-contact, #pigeon-ticket, #pigeon-new-user.
SLACK_BOT_TOKEN=your-slack-bot-token-here
# Optional overrides (defaults: pigeon-contact, pigeon-ticket, pigeon-new-user)
# SLACK_CHANNEL_CONTACT=pigeon-contact
# SLACK_CHANNEL_TICKET=pigeon-ticket
# SLACK_CHANNEL_NEW_USER=pigeon-new-user

# App notifications (verification, 2FA, password reset, in-app alerts): use SendGrid from your inbox (e.g. notification@pigeon.com).
# Set SENDGRID_API_KEY (above) and NOTIFICATION_FROM_EMAIL. No SMTP needed for notifications.
# NOTIFICATION_FROM_EMAIL=tarinagarwal@gmail.com
# NOTIFICATION_FROM_NAME=Pigeon
# Optional: SMTP fallback if you prefer SMTP instead of SendGrid for app notifications
NOTIFICATION_SMTP_HOST=smtp.example.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=your_smtp_username_here
NOTIFICATION_SMTP_PASSWORD=your_smtp_password_here

# SendGrid Inbound Parse (receiving mail). When user enables "Receiving" for a domain, we create
# a parse setting pointing to this URL. SendGrid POSTs incoming email here. Must be publicly reachable.
SENDGRID_INBOUND_PARSE_URL=https://your-api.com/api/webhooks/sendgrid/inbound
# Optional: shared secret to verify webhook requests (set same value in SendGrid Inbound Parse settings).
# SENDGRID_INBOUND_VERIFY_TOKEN=your-verify-token


MAX_CONCURRENT_CAMPAIGN_BATCHES=20
STALE_RUNNING_JOB_HOURS=24
# Campaign batch jobs running > this (hours) are auto-stopped and rescheduled in 5 min (like Stop)
STALE_CAMPAIGN_AUTO_RESTART_HOURS=6
INSTANCE_TERMINATING_FILE=/signals/instance-terminating
EMAIL_DEBUG=

# Razorpay (India subscriptions). Create monthly and annual plans in Dashboard.
# Plan IDs can be set per plan in the database (admin: plan.razorpay_plan_id_monthly / razorpay_plan_id_annual).
# If not set in DB, these env vars are used as fallback.
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
# Monthly plans (fallback when not in DB)
RAZORPAY_PLAN_STARTER=your_razorpay_plan_starter_id_here
RAZORPAY_PLAN_GROWTH=your_razorpay_plan_growth_id_here
RAZORPAY_PLAN_PRO=your_razorpay_plan_pro_id_here
RAZORPAY_PLAN_SCALE=your_razorpay_plan_scale_id_here
# Annual plans (fallback when not in DB)
# RAZORPAY_PLAN_STARTER_ANNUAL=plan_xxxx
# RAZORPAY_PLAN_GROWTH_ANNUAL=plan_xxxx
# RAZORPAY_PLAN_PRO_ANNUAL=plan_xxxx
# RAZORPAY_PLAN_SCALE_ANNUAL=plan_xxxx

# Lemon Squeezy (international subscriptions, non-India). Create products/variants in Lemon Squeezy Dashboard.
# Plan variant IDs can be set per plan in the database (admin: plan.lemon_squeezy_variant_id_monthly / lemon_squeezy_variant_id_annual).
# If not set in DB, these env vars are used as fallback.
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here
LEMONSQUEEZY_STORE_ID=your_store_id_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here
# Webhook URL: https://your-api.com/api/billing/lemon-squeezy/webhook (subscribe to subscription_* and order_* events)
# Monthly variant IDs (fallback when not in DB)
# LEMONSQUEEZY_VARIANT_STARTER_MONTHLY=123456
# LEMONSQUEEZY_VARIANT_GROWTH_MONTHLY=123457
# LEMONSQUEEZY_VARIANT_PRO_MONTHLY=123458
# LEMONSQUEEZY_VARIANT_SCALE_MONTHLY=123459
# Annual variant IDs (fallback when not in DB)
# LEMONSQUEEZY_VARIANT_STARTER_ANNUAL=123460
# LEMONSQUEEZY_VARIANT_GROWTH_ANNUAL=123461
# LEMONSQUEEZY_VARIANT_PRO_ANNUAL=123462
# LEMONSQUEEZY_VARIANT_SCALE_ANNUAL=123463
# One-time credits top-up product/variant (900 credits for ₹1000 / $10)
# LEMONSQUEEZY_VARIANT_CREDIT_TOPUP=123999

# off / shadow / high_confidence / full
WARMUP_CLOSE_NETWORK_MODE=shadow
# Recipient for the admin "test warm-up receiver account" action. Defaults to test@example.com.
# WARMUP_TEST_EMAIL_TO=test@example.com

# Blog image hosting. Only needed to run scripts/migrate_blog_images_cloudinary_to_imagekit.py.
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
# IMAGEKIT_UPLOAD_FOLDER=/blogs
